controller_manager:
  ros__parameters:
    update_rate: 100

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

    servo_controller:
      type: velocity_controllers/JointGroupVelocityController

    arm_trajectory_controller:
      type: joint_trajectory_controller/JointTrajectoryController


joint_state_broadcaster:
  ros__parameters: {}


servo_controller:
  ros__parameters:
    joints:
      - base_joint
      - shoulder_joint
      - elbow_joint

    command_interfaces:
      - velocity

    state_interfaces:
      - position
      - velocity

    command_timeout: 0.2
    state_publish_rate: 50


arm_trajectory_controller:
  ros__parameters:
    joints:
      - base_joint
      - shoulder_joint
      - elbow_joint

    command_interfaces:
      - velocity

    state_interfaces:
      - position
      - velocity

    state_publish_rate: 50.0
    action_monitor_rate: 20.0

    gains:
      base_joint:
        p: 4.0
        i: 0.0
        d: 0.1

      shoulder_joint:
        p: 4.0
        i: 0.0
        d: 0.1

      elbow_joint:
        p: 4.0
        i: 0.0
        d: 0.1
